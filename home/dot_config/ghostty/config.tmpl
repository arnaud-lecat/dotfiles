split-divider-color = #cba6f7

unfocused-split-opacity = 0.4
unfocused-split-fill = #11111b

background-opacity = 0.95
background-blur = true
clipboard-read = allow
custom-shader = ~/.ghostty-shaders/cursor_blaze.glsl
font-family = "Cartograph CF"
font-feature = -calt, -liga, -dlig
font-size = 13.5
shell-integration = fish
theme = catppuccin-{{ .catppuccin_flavor }}.conf
window-height = 36
window-inherit-working-directory = false
window-padding-x = 5
window-padding-y = 5
window-width = 120
working-directory = home

palette-generate = true

# Split Right
keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+down=new_split:down
